{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Smith",
  "version": "0.1.1",
  "identifier": "com.jeeyo.smith",
  "build": {
    "beforeDevCommand": "npm run build:server",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:ui && npm run build:server",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smith",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "backgroundColor": "#09090b",
        "center": true,
        "decorations": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../dist-server/**/*",
      "../dist/**/*"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}

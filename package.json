{
  "name": "smith",
  "version": "0.2.1",
  "description": "Smith",
  "type": "module",
  "author": "jeeyo <jeeyo@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeeyo/smith.git"
  },
  "homepage": "https://github.com/jeeyo/smith",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node22 --outfile=dist-server/index.cjs --external:fsevents",
    "build": "tsc && npm run build:ui && npm run build:server",
    "preview": "vite preview",
    "server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,VITE,TAURI\" -c \"blue,green,magenta\" \"tsx watch src/server/index.ts\" \"vite\" \"tauri dev\"",
    "tauri:build": "npm run build:ui && npm run build:server && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@types/ws": "^8.5.14",
    "@vectorize-io/hindsight-all": "^1.0.0",
    "@vectorize-io/hindsight-client": "^1.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "marked": "^16.4.2",
    "mermaid": "^12.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.3",
    "puppeteer-core": "^25.15.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
